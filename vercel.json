{
  "buildCommand": "node scripts/prepare-vercel.js",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/skills",
      "destination": "/skills/index.html"
    },
    {
      "source": "/skills/(.*)",
      "destination": "/skills/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
